<%- include('partials/head') %>
<main id="main">
  <section class="pageHero">
    <div class="container productIntro">
      <div>
        <span class="kicker"><%= eyebrow %></span>
        <h1><%= heading %></h1>
        <p><%= intro %></p>
        <div class="heroActions"><a class="button" href="#plans">View plans</a><a class="button secondary" href="/contact">Ask sales</a></div>
      </div>
      <img src="/images/<%= type==='dedicated'?'dedicated':type==='vpn'?'vpn':'vps' %>.svg" alt="<%= type==='dedicated'?'Dedicated server':type==='vpn'?'VPN security':'Virtual server' %> illustration">
    </div>
  </section>

  <section class="section" id="plans">
    <div class="container">
      <div class="sectionHead"><div><span class="kicker">Plans</span><h2>Pick the closest fit.</h2></div><p>Need something different? Send us the requirement and we will confirm what is available.</p></div>
      <div class="pricingGrid <%= type==='vps'?'pricingGridVps':'' %>">
        <% products.forEach(function(p){ %>
          <article class="priceCard <%= p.featured?'featured':'' %>">
            <% if(p.featured){ %><div class="popular">Popular choice</div><% } %>
            <div class="priceTop"><div><span class="tag"><%= type==='dedicated'?'Dedicated':type==='vpn'?'VPN':'VPS' %></span><h2><%= p.name %></h2></div><div class="price"><span>£</span><strong><%= Number(p.price).toFixed(Number(p.price)%1?2:0) %></strong><small>/<%= p.term||'month' %></small></div></div>
            <p><%= p.description %></p>
            <div class="specList">
              <% if(p.cpu){ %><div><span>Compute</span><strong><%= p.cpu %></strong></div><% } %>
              <% if(p.cores){ %><div><span>Cores</span><strong><%= p.cores %></strong></div><% } %>
              <% if(p.ram){ %><div><span>Memory</span><strong><%= p.ram %></strong></div><% } %>
              <% if(p.storage){ %><div><span>Storage</span><strong><%= p.storage %></strong></div><% } %>
              <% if(p.traffic){ %><div><span>Traffic</span><strong><%= p.traffic %></strong></div><% } %>
              <% if(p.network){ %><div><span>Network</span><strong><%= p.network %></strong></div><% } %>
              <% if(p.ip){ %><div><span>Addressing</span><strong><%= p.ip %></strong></div><% } %>
              <% if(p.devices){ %><div><span>Devices</span><strong><%= p.devices %></strong></div><% } %>
              <% if(p.protocols){ %><div><span>Protocols</span><strong><%= p.protocols %></strong></div><% } %>
              <% if(p.bandwidth){ %><div><span>Usage</span><strong><%= p.bandwidth %></strong></div><% } %>
              <% if(p.regions){ %><div><span>Locations</span><strong><%= p.regions %></strong></div><% } %>
            </div>
            <% if(p.setup){ %><div class="setupFee">One-time setup from £<%= Number(p.setup).toFixed(0) %></div><% } %>
            <a class="button full" href="/order/<%= type %>/<%= p.slug %>">Check availability</a>
          </article>
        <% }) %>
      </div>
      <div class="notice"><strong>Before payment</strong><p><%= note %> We confirm the material configuration and final GBP amount before requesting payment.</p></div>
    </div>
  </section>

  <section class="section sectionMuted">
    <div class="container">
      <span class="kicker">What to expect</span>
      <h2><%= type==='dedicated'?'Bare metal, clearly defined.':type==='vpn'?'Private connectivity without exaggerated claims.':'Virtual compute you control.' %></h2>
      <div class="productEssentials">
        <% if(type==='vps'){ %>
          <div class="productEssential"><strong>Self-managed</strong><span>You control the operating system, applications, updates and backups unless otherwise agreed.</span></div>
          <div class="productEssential"><strong>NVMe storage</strong><span>Fast storage for common web, app, API, database and self-hosted workloads.</span></div>
          <div class="productEssential"><strong>Regional options</strong><span>Deployment locations are confirmed against live capacity when you order.</span></div>
        <% } else if(type==='dedicated'){ %>
          <div class="productEssential"><strong>Physical resources</strong><span>CPU, memory and local storage are allocated as a dedicated physical server.</span></div>
          <div class="productEssential"><strong>Full system control</strong><span>Standard products are intended to provide root or administrator-level access.</span></div>
          <div class="productEssential"><strong>Stock checked first</strong><span>We verify the requested hardware and location before payment is requested.</span></div>
        <% } else { %>
          <div class="productEssential"><strong>WireGuard & OpenVPN</strong><span>Established protocols are available on supported plans and devices.</span></div>
          <div class="productEssential"><strong>Clear device limits</strong><span>Each plan states the number of devices it is intended to cover.</span></div>
          <div class="productEssential"><strong>Responsible privacy</strong><span>We do not promise absolute anonymity or market the service for unlawful activity.</span></div>
        <% } %>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faqList">
      <span class="kicker">Quick answers</span>
      <h2>Before you order</h2>
      <% if(type==='vps'){ %>
        <details open><summary>Is the VPS managed?</summary><p>Standard VPS plans are self-managed infrastructure. You manage the operating system, applications, security configuration and backups unless an accepted order explicitly includes managed support.</p></details>
        <details><summary>Can I choose the operating system?</summary><p>Common Linux distributions are normally the simplest option. Ask sales if you need a particular image or licensed operating system.</p></details>
        <details><summary>Can I request another location?</summary><p>Yes. Tell us the preferred country or region and we will confirm availability.</p></details>
      <% } else if(type==='dedicated'){ %>
        <details open><summary>Why do you check availability first?</summary><p>Dedicated servers are physical inventory. CPU, storage and datacentre combinations can sell out, so we confirm stock before payment.</p></details>
        <details><summary>Can I request more RAM or storage?</summary><p>Often yes, subject to compatible hardware and stock. Send the desired specification to sales for review.</p></details>
        <details><summary>Is the server managed?</summary><p>Standard dedicated servers are primarily unmanaged infrastructure unless management is explicitly included in the accepted order.</p></details>
      <% } else { %>
        <details open><summary>Does VPN4U guarantee anonymity?</summary><p>No. A VPN is one privacy and security layer; it does not prevent every form of tracking or make unlawful activity lawful.</p></details>
        <details><summary>Is there a fixed bandwidth cap?</summary><p>Current plans are advertised without a fixed bandwidth cap, subject to available network capacity and the Acceptable Use Policy.</p></details>
        <details><summary>Which locations are available?</summary><p>Plans use multiple European and international exit locations. The exact active list can change with service capacity.</p></details>
      <% } %>
      <p style="margin-top:18px"><a class="textLink" href="/faq">Read the full FAQ →</a></p>
    </div>
  </section>

  <section class="section sectionMuted"><div class="container cta"><div><span class="kicker">Need a custom configuration?</span><h2>Send us the requirement.</h2><p>Tell us the workload, preferred location and approximate resources. We will confirm whether a standard or custom option fits.</p></div><a class="button" href="/contact">Contact sales</a></div></section>
</main>
<%- include('partials/footer') %>
