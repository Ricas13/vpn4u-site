<%- include('partials/head') %>
<main id="main"><section class="pageHero"><div class="container"><span class="kicker"><%= eyebrow %></span><h1><%= heading %></h1><p><%= intro %></p><div class="heroPills"><span>GBP pricing</span><span>Manual order approval</span><span>Support by VPN4U</span></div></div></section><section class="section"><div class="container"><div class="pricingGrid <%= type==='vps'?'pricingGridVps':'' %>">
<% products.forEach(function(p){ %><article class="priceCard <%= p.featured?'featured':'' %>"><% if(p.featured){ %><div class="popular">Popular choice</div><% } %><div class="priceTop"><div><span class="tag"><%= type==='dedicated'?'Dedicated':type==='vpn'?'VPN':'VPS' %></span><h2><%= p.name %></h2></div><div class="price"><span>£</span><strong><%= Number(p.price).toFixed(Number(p.price)%1?2:0) %></strong><small>/<%= p.term||'month' %></small></div></div><p><%= p.description %></p><div class="specList">
<% if(p.cpu){ %><div><span>Compute</span><strong><%= p.cpu %></strong></div><% } %><% if(p.cores){ %><div><span>Cores</span><strong><%= p.cores %></strong></div><% } %><% if(p.ram){ %><div><span>Memory</span><strong><%= p.ram %></strong></div><% } %><% if(p.storage){ %><div><span>Storage</span><strong><%= p.storage %></strong></div><% } %><% if(p.traffic){ %><div><span>Traffic</span><strong><%= p.traffic %></strong></div><% } %><% if(p.network){ %><div><span>Network</span><strong><%= p.network %></strong></div><% } %><% if(p.ip){ %><div><span>Addressing</span><strong><%= p.ip %></strong></div><% } %><% if(p.devices){ %><div><span>Devices</span><strong><%= p.devices %></strong></div><% } %><% if(p.protocols){ %><div><span>Protocols</span><strong><%= p.protocols %></strong></div><% } %><% if(p.bandwidth){ %><div><span>Usage</span><strong><%= p.bandwidth %></strong></div><% } %><% if(p.regions){ %><div><span>Locations</span><strong><%= p.regions %></strong></div><% } %></div><% if(p.setup){ %><div class="setupFee">One-time setup from £<%= Number(p.setup).toFixed(0) %></div><% } %><a class="button full" href="/order/<%= type %>/<%= p.slug %>">Order / check availability</a></article><% }) %>
</div><div class="notice"><strong>Availability note</strong><p><%= note %> Published prices are indicative retail prices in GBP and may change before an order is accepted. Taxes, licensing and optional add-ons may apply.</p></div></div></section></main>
<%- include('partials/footer') %>
