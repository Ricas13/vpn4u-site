<%- include('partials/head') %>
<main id="main">
  <section class="pageHero">
    <div class="container"><span class="kicker">Contact</span><h1>Talk to VPN4U</h1><p>Sales, configuration questions, existing-service support and general enquiries. We normally aim to respond to standard enquiries within one business day.</p><div class="heroPills"><span>Sales enquiries</span><span>Existing-service support</span><span>Abuse reporting</span><span>Privacy requests</span></div></div>
  </section>
  <section class="section"><div class="container contactGrid">
    <div>
      <div class="contactCards">
        <article><span>Sales & new orders</span><a href="mailto:<%= site.emails.sales %>"><%= site.emails.sales %></a><p class="muted">Plan selection, custom configurations, locations, availability and commercial questions.</p></article>
        <article><span>Existing-service support</span><a href="mailto:<%= site.emails.support %>"><%= site.emails.support %></a><p class="muted">Provisioning, access, service faults, cancellations and account assistance.</p></article>
        <article><span>Abuse & network complaints</span><a href="mailto:<%= site.emails.abuse %>"><%= site.emails.abuse %></a><p class="muted">Include the IP or hostname, timestamps with timezone and supporting evidence where possible.</p></article>
        <article><span>Privacy & data protection</span><a href="mailto:<%= site.emails.privacy %>"><%= site.emails.privacy %></a><p class="muted">Privacy questions and requests concerning personal information.</p></article>
      </div>
      <div class="notice"><strong>Existing customer?</strong><p>For an active service issue, include the order or service reference, affected IP/hostname where relevant, the time the problem began and a concise description of what you have already checked.</p></div>
      <div class="notice"><strong>Please do not send secrets</strong><p>Do not include passwords, private keys, payment-card numbers or unnecessary sensitive personal information in an enquiry.</p></div>
    </div>
    <form class="formPanel" method="post" action="/contact">
      <h2>Send an enquiry</h2>
      <p class="muted">Use this form for general or pre-sales questions. An order request can also be submitted directly from a product page.</p>
      <% if(typeof formError!=='undefined'&&formError){ %><div class="formError"><%= formError %></div><% } %>
      <div class="field"><label for="name">Name</label><input id="name" name="name" required maxlength="120" value="<%= typeof form!=='undefined'?form.name||'':'' %>"></div>
      <div class="field"><label for="email">Email</label><input id="email" type="email" name="email" required maxlength="180" value="<%= typeof form!=='undefined'?form.email||'':'' %>"></div>
      <div class="field"><label for="company">Company <small>optional</small></label><input id="company" name="company" maxlength="180" value="<%= typeof form!=='undefined'?form.company||'':'' %>"></div>
      <div class="field"><label for="subject">Subject</label><input id="subject" name="subject" maxlength="180" value="<%= typeof form!=='undefined'?form.subject||'General enquiry':'' %>"></div>
      <div class="field"><label for="message">How can we help?</label><textarea id="message" name="message" required maxlength="5000" rows="7"><%= typeof form!=='undefined'?form.message||'':'' %></textarea></div>
      <div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
      <label class="check"><input type="checkbox" name="consent" value="1" required> <span>I agree that VPN4U may use these details to respond to my enquiry. See the <a href="/legal/privacy">Privacy Policy</a>.</span></label>
      <button class="button" type="submit">Send enquiry</button>
    </form>
  </div></section>
  <section class="section sectionMuted"><div class="container"><div class="sectionHead"><div><span class="kicker">Before contacting us</span><h2>Help us answer faster</h2></div></div><div class="featureGrid"><article><h3>New server</h3><p>Tell us the workload, preferred region, CPU, RAM, storage, traffic and any software or IP requirements.</p></article><article><h3>Existing service</h3><p>Include the service reference and a clear description of the fault, including relevant timestamps and error messages.</p></article><article><h3>Abuse report</h3><p>Use the dedicated abuse address so the report can be assessed separately from normal sales and support traffic.</p></article><article><h3>Privacy request</h3><p>Use the privacy address and avoid sending identity documents unless we specifically request appropriate verification.</p></article></div></div></section>
</main>
<%- include('partials/footer') %>
