<%- include('partials/head') %>
<main id="main"><section class="pageHero"><div class="container"><span class="kicker">Contact</span><h1>Talk to VPN4U</h1><p>Sales, configuration questions and general enquiries. We normally aim to respond within one business day.</p></div></section><section class="section"><div class="container contactGrid"><div><div class="contactCards"><article><span>Sales</span><a href="mailto:<%= site.emails.sales %>"><%= site.emails.sales %></a></article><article><span>Support</span><a href="mailto:<%= site.emails.support %>"><%= site.emails.support %></a></article><article><span>Abuse</span><a href="mailto:<%= site.emails.abuse %>"><%= site.emails.abuse %></a></article></div><div class="notice"><strong>Existing customer?</strong><p>For an active service issue, email support and include the service or order reference where possible.</p></div></div><form class="formPanel" method="post" action="/contact"><h2>Send an enquiry</h2><% if(typeof formError!=='undefined'&&formError){ %><div class="formError"><%= formError %></div><% } %><div class="field"><label for="name">Name</label><input id="name" name="name" required maxlength="120" value="<%= typeof form!=='undefined'?form.name||'':'' %>"></div><div class="field"><label for="email">Email</label><input id="email" type="email" name="email" required maxlength="180" value="<%= typeof form!=='undefined'?form.email||'':'' %>"></div><div class="field"><label for="company">Company <small>optional</small></label><input id="company" name="company" maxlength="180" value="<%= typeof form!=='undefined'?form.company||'':'' %>"></div><div class="field"><label for="subject">Subject</label><input id="subject" name="subject" maxlength="180" value="<%= typeof form!=='undefined'?form.subject||'General enquiry':'' %>"></div><div class="field"><label for="message">How can we help?</label><textarea id="message" name="message" required maxlength="5000" rows="7"><%= typeof form!=='undefined'?form.message||'':'' %></textarea></div><div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><label class="check"><input type="checkbox" name="consent" value="1" required> <span>I agree that VPN4U may use these details to respond to my enquiry. See the <a href="/legal/privacy">Privacy Policy</a>.</span></label><button class="button" type="submit">Send enquiry</button></form></div></section></main>
<%- include('partials/footer') %>
