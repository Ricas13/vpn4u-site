<%- include('partials/head') %>
<main id="main"><section class="pageHero compact"><div class="container"><span class="kicker">Order request</span><h1><%= product.name %></h1><p>Confirm your contact details and requirements. We check availability before asking for payment.</p></div></section><section class="section"><div class="container orderGrid"><div class="orderSummary"><span class="tag"><%= type==='dedicated'?'Dedicated server':type==='vpn'?'Private VPN':'Virtual private server' %></span><h2><%= product.name %></h2><div class="orderPrice"><span>£</span><strong><%= Number(product.price).toFixed(Number(product.price)%1?2:0) %></strong><small>/<%= product.term||'month' %></small></div><p><%= product.description %></p><div class="specList compactSpecs"><% Object.entries({Compute:product.cpu,Cores:product.cores,Memory:product.ram,Storage:product.storage,Traffic:product.traffic,Network:product.network,Devices:product.devices,Protocols:product.protocols,Locations:product.regions}).forEach(function(entry){ if(entry[1]){ %><div><span><%= entry[0] %></span><strong><%= entry[1] %></strong></div><% } }) %></div><% if(product.setup){ %><div class="setupFee">Indicative one-time setup: £<%= product.setup %></div><% } %><a class="textLink" href="/<%= type %>">← Back to plans</a></div><form class="formPanel" method="post" action="/order/<%= type %>/<%= product.slug %>"><h2>Request this service</h2><p class="muted">No payment is taken on this form.</p><% if(typeof formError!=='undefined'&&formError){ %><div class="formError"><%= formError %></div><% } %><div class="field"><label for="name">Name</label><input id="name" name="name" required maxlength="120" value="<%= typeof form!=='undefined'?form.name||'':'' %>"></div><div class="field"><label for="email">Email</label><input id="email" type="email" name="email" required maxlength="180" value="<%= typeof form!=='undefined'?form.email||'':'' %>"></div><div class="field"><label for="company">Company <small>optional</small></label><input id="company" name="company" maxlength="180" value="<%= typeof form!=='undefined'?form.company||'':'' %>"></div><div class="field"><label for="country">Country</label><input id="country" name="country" maxlength="100" value="<%= typeof form!=='undefined'?form.country||'United Kingdom':'' %>"></div><div class="field"><label for="message">Configuration / requirements</label><textarea id="message" name="message" required maxlength="5000" rows="6"><%= typeof form!=='undefined'?form.message||`I am interested in ${product.name}. Please confirm availability and next steps.` %></textarea></div><div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><label class="check"><input type="checkbox" name="consent" value="1" required> <span>I agree that VPN4U may use these details to respond to this order request.</span></label><button class="button full" type="submit">Submit order request</button><div class="checkoutPreview"><span>Prefer to see the checkout stage?</span><a href="/checkout/<%= type %>/<%= product.slug %>">Continue to payment preview →</a></div></form></div></section></main>
<%- include('partials/footer') %>
