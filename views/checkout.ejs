<%- include('partials/head') %>
<main id="main"><section class="pageHero compact"><div class="container"><span class="kicker">Checkout</span><h1><%= product.name %></h1><p>Final payment is requested only after service availability has been confirmed.</p></div></section><section class="section"><div class="container checkoutShell"><div class="checkoutCard"><div class="checkoutHeader"><div><span class="tag">Order summary</span><h2><%= product.name %></h2></div><div class="orderPrice"><span>£</span><strong><%= Number(product.price).toFixed(Number(product.price)%1?2:0) %></strong><small>/<%= product.term||'month' %></small></div></div><div class="checkoutRows"><div><span>Service</span><strong><%= type==='dedicated'?'Dedicated server':type==='vpn'?'Private VPN':'Virtual private server' %></strong></div><div><span>Availability</span><strong>Confirmation required</strong></div><div><span>Payment</span><strong>Not requested yet</strong></div><% if(product.setup){ %><div><span>Indicative setup</span><strong>£<%= product.setup %></strong></div><% } %></div><div class="paymentBox"><div class="lockIcon">✓</div><div><h3>Payment is intentionally disabled at this stage.</h3><p>VPN4U confirms stock, location and the final order configuration before issuing a payment request or invoice. This prevents customers from paying for capacity that may no longer be available.</p></div></div><button class="button full disabled" type="button" disabled>Pay securely</button><a class="button secondary full" href="/order/<%= type %>/<%= product.slug %>">Submit an order request instead</a></div></div></section></main>
<%- include('partials/footer') %>
